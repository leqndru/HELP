{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend-campominado",
  "main": "src/index.js",
  "compatibility_date": "2024-01-01",
  "d1_databases": [
    {
      "binding": "DB", 
      "database_name": "campominado-db",
      "database_id": "06eefa3b-f6d5-4352-9227-bc3550bc8698"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}